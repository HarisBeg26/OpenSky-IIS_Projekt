# Copy this file to .env. Never commit the populated .env file.

# OpenSky credentials are optional for anonymous fetches, but authenticated
# access is more reliable and is recommended when reproducing the pipeline.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_URL=https://opensky-network.org/api/states/all

# Required to pull private DVC artifacts from the DagsHub S3 remote.
DAGSHUB_S3_ENDPOINT_URL=https://dagshub.com/HarisBeg26/OpenSky-IIS_Projekt.s3
DAGSHUB_ACCESS_KEY_ID=
DAGSHUB_SECRET_ACCESS_KEY=

# Local training uses ./mlruns by default. Fill these only for remote DagsHub
# MLflow tracking or set MLFLOW_TRACKING_MODE=remote.
MLFLOW_TRACKING_MODE=local
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# HuggingFace zero-shot risk classifier is enabled by default.
HF_INFERENCE_ENABLED=true
HF_TOKEN=
HF_MODEL_ID=facebook/bart-large-mnli

# Optional local model-as-a-service configuration.
MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_TOKEN=local-skywatch-token
ALLOW_LOCAL_MODEL_FALLBACK=true
