# Optional HuggingFace zero-shot risk classifier.
HF_INFERENCE_ENABLED=false
HF_TOKEN=hf_replace_with_your_token
HF_MODEL_ID=facebook/bart-large-mnli

# Optional local model-as-a-service configuration.
MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_TOKEN=replace-with-a-shared-secret
ALLOW_LOCAL_MODEL_FALLBACK=true
